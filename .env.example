# ===================================================
# Samālōcane - Environment Configuration
# ===================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (Next.js default: 3000)
PORT=3000

# Base URL of the Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===================================================
# Connection string format: postgresql://[user]:[password]@[host]:[port]/[database]
# If credentials are not provided or unreachable in local demo mode,
# Samālōcane falls back to a safe in-memory mock store for verification.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samalocane

# Individual parameters (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_postgres_password
PGDATABASE=samalocane
PGSSL=false

# ===================================================
# AUTHENTICATION & SECURITY (JWT)
# ===================================================
# Minimum 32-character high-entropy secret string for signing session JWTs
JWT_SECRET=samalocane_super_secure_jwt_secret_token_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Cookie Security Flags ('lax' in development, 'strict' or 'none' with secure in production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ===================================================
# GOOGLE OAUTH 2.0 / OPENID CONNECT PREPARATION
# ===================================================
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===================================================
# FUTURE INTEGRATIONS (Documented for Later Phases)
# ===================================================
# WebRTC STUN/TURN (Cellular CGNAT traversal for 2G/3G coastal towers)
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

